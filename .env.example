# Feishu credentials — choose one of the two methods below

# Method 1: Environment variables (recommended for CI/production)
FEISHU_APP_ID=cli_xxxxxxxxxxxx
FEISHU_APP_SECRET=your_feishu_app_secret
FEISHU_CHAT_ID=oc_xxxxxxxxxxxx

# Method 2: Config file (copy config.example.json → config.json and fill in values)
# The default path is ~/.claude-runner/config.json
# Override with:
# FEISHU_CONFIG_PATH=~/.claude-runner/config.json

# Optional: override default directories
# CLAUDE_RUNNER_STATUS_DIR=~/.claude-runner/runs   # where run records are stored
# CLAUDE_RUNNER_WORKDIR=~/your-workspace            # default working dir for Claude
